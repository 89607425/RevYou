# LLM — DeepSeek
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=sk-xxx
LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=4096

# Agent loop controls
MAX_LLM_CALLS_PER_AGENT=12
MAX_REFLECT_LOOPS=2

# TAPD
TAPD_API_URL=https://api.tapd.cn
TAPD_TOKEN=xxx
TAPD_WORKSPACE_IDS=xxx

# App
APP_HOST=127.0.0.1
APP_PORT=8000
